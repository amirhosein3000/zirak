# Zirak (زیرک) — every environment variable. Copy to `.env` and fill in. Never commit `.env`.

# ---------------------------------------------------------------------------------------------
# Trading mode and HARD safety limits
# Paper trading is the default. Real orders need ALL of: LIVE_TRADING=true, MAX_ORDER_TMN,
# MAX_ORDER_USDT, DAILY_LOSS_LIMIT_PCT, WALLEX_API_KEY, and the kill switch not engaged.
# ---------------------------------------------------------------------------------------------
LIVE_TRADING=false
# Hard cap per live order, in quote currency (Toman / USDT).
MAX_ORDER_TMN=
MAX_ORDER_USDT=
# Halt new buys (and flatten) when today's equity falls this % below the start of the UTC day.
DAILY_LOSS_LIMIT_PCT=3
# Live "market" orders are sent as LIMIT orders at most this far (basis points) from the reference price.
LIVE_MAX_SLIPPAGE_BPS=50
# Cancel live orders that are still unfilled after this many seconds.
LIVE_ORDER_TTL_S=30
# Kill switch file. When it exists, every bot stops and no new live order can be sent.
# `zirak kill` creates it, `zirak reset-kill` removes it. Default: <DATA_DIR>/KILL
KILL_FILE=

# ---------------------------------------------------------------------------------------------
# Exchange
# ---------------------------------------------------------------------------------------------
# Wallex API key: TRADING permission only, NEVER withdrawal. Sent as the x-api-key header.
WALLEX_API_KEY=
# REST base URL (docs/wallex-api/basics.md). Verified live on 2026-10-22; api.wallex.com does not resolve.
WALLEX_BASE_URL=https://api.wallex.ir
# WebSocket: Centrifugo v2 first, deprecated v1 as fallback (v2 handshake often answers HTTP 503).
WALLEX_WS_URL=wss://api.wallex.ir/connection/websocket
WALLEX_WS_V1_URL=wss://api.wallex.ir/ws
# The local HTTPS proxy/VPN broke TLS to Wallex on the dev machine, so Wallex calls go direct by default.
WALLEX_USE_SYSTEM_PROXY=false
WALLEX_TIMEOUT_S=20
# Challenge credit (prop) account, docs/wallex-api/credit-account.md. WALLEX_API_KEY must then be the
# credit account's own key. true = balances from /v1/account/balances-detail.
WALLEX_CREDIT_ACCOUNT=false
WALLEX_SUB_ACCOUNT_CLIENT_ID=
# Numeric package id: its unavailableMarkets are removed from the agent's markets.
WALLEX_PROP_PACKAGE_ID=
# "replay" = offline recorded data (DB, else REPLAY_DIR). "wallex" = live public Wallex prices for the
# market screen and the paper bot (orders are still simulated unless every live-trading condition holds).
DATA_SOURCE=replay
MARKETS=USDTTMN,BTCTMN,BTCUSDT,ETHTMN,ETHUSDT

# ---------------------------------------------------------------------------------------------
# Paper trading / backtest simulation
# ---------------------------------------------------------------------------------------------
# UNVERIFIED placeholders: set to your Wallex fee tier (percent, e.g. 0.25 = 0.25 %).
FEE_TAKER_PCT=0.25
FEE_MAKER_PCT=0.20
# Extra adverse price move on every market fill, in basis points (5 = 0.05 %).
SLIPPAGE_BPS=5
# Max share of one candle's volume a single order may fill (0.10 = 10 %); bigger orders fill partially.
FILL_PARTICIPATION=0.10
PAPER_START_TMN=100000000
PAPER_START_USDT=1000

# ---------------------------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------------------------
# Runtime data dir (reports, KILL file, recorder DB). Default: <repo>/data
DATA_DIR=
# Recorder SQLite DB. Default: <DATA_DIR>/zirak.sqlite
DB_PATH=
# Candle CSVs used when the DB has no data. Default: backend/tests/fixtures/wallex (real Wallex sample).
# backend/tests/fixtures/sample is a SYNTHETIC dataset used by unit tests.
REPLAY_DIR=

# ---------------------------------------------------------------------------------------------
# Recorder (`zirak record`): REST polling intervals in seconds, and stored candle resolutions.
# 15m and 4h are derived from 1m and 1h when loading.
# ---------------------------------------------------------------------------------------------
RECORDER_RESOLUTIONS=1m,1h,1d
RECORDER_CANDLE_INTERVAL_S=60
RECORDER_BOOK_INTERVAL_S=15
RECORDER_TRADES_INTERVAL_S=30
# Live paper runner (DATA_SOURCE=wallex): how often to poll the order book and new candles.
LIVE_POLL_S=5
# Live data only: no new buys when the newest closed candle (or the feed) is older than this many
# seconds, or the order book is empty/crossed. Exits and the kill switch still work.
STALE_DATA_S=120

# ---------------------------------------------------------------------------------------------
# LLM (OpenAI-compatible chat completions). MOCK_LLM=true needs no key: every feature falls back
# to deterministic Persian templates / the rule-based strategy parser.
# ---------------------------------------------------------------------------------------------
MOCK_LLM=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=30

# ---------------------------------------------------------------------------------------------
# Optional modules (backend/zirak/modules). Comma-separated; remove a name to switch it off.
# ---------------------------------------------------------------------------------------------
MODULES=regime,orderbook,news,portfolio,alerts,coach,competition
# News: "mock" works offline; "rss" reads NEWS_RSS_URLS (official RSS feeds only, comma-separated).
NEWS_SOURCE=mock
NEWS_RSS_URLS=
# true = very negative news shrinks the size of new buys of the running paper bot (never enlarges).
NEWS_RISK=false
# Alerts: checked every ALERTS_INTERVAL_S. Telegram / Bale delivery only when token + chat id are set.
ALERTS_INTERVAL_S=30
ALERTS_TELEGRAM_TOKEN=
ALERTS_TELEGRAM_CHAT_ID=
ALERTS_BALE_TOKEN=
ALERTS_BALE_CHAT_ID=

# ---------------------------------------------------------------------------------------------
# API / frontend
# ---------------------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
# Container entrypoint (backend/start.sh, Docker / Liara): run the trading agent next to the API.
#   ZIRAK_AGENT=off | shadow | live | live,shadow     ZIRAK_BOOTSTRAP=true: backfill + train on first start
ZIRAK_AGENT=off
ZIRAK_BOOTSTRAP=false
# Challenge window (UTC, with a zone). Overrides "clock" in the agent config: no new entries 4 h before the end,
# everything back to Toman 30 min before it. Leave empty outside the challenge.
ZIRAK_CHALLENGE_START=
ZIRAK_CHALLENGE_END=
# NEVER put real keys or tokens in this file: it is committed. Use .env (git-ignored), Liara app variables
# or GitHub secrets (LIARA_API_TOKEN, LIARA_TEAM_ID for .github/workflows/deploy-liara.yml).

# Read by the Next.js app (build time and dev).
NEXT_PUBLIC_API_URL=http://localhost:8000
